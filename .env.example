# Copy to .env and fill in. Never commit .env.

# ---- Database (Supabase) ----
# Supabase dashboard > Connect. Paste the URLs exactly as shown ("postgresql://..." is fine; the
# driver is selected automatically). URL-encode special characters in the password (@ -> %40).
# Transaction pooler (port 6543): used by the API and collector.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Session pooler (port 5432) or direct connection: used by Alembic. Use the session pooler if the
# direct host is IPv6-only on your network.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Supabase Auth ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# Only if the project still uses the legacy HS256 secret; otherwise leave empty.
SUPABASE_JWT_SECRET=
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public by design; safe only because the data API is locked by migration.
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000
# Optional: how often the browser syncs while the tab is visible (ms).
# VITE_SYNC_INTERVAL_MS=30000
# Show "Continue with Google" once the Google provider is enabled in Supabase Auth.
VITE_ENABLE_GOOGLE_AUTH=false

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Comma-separated platform operators: may see collector health across all workspaces.
ADMIN_EMAILS=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ---- Collector ----
COLLECT_INTERVAL_SECONDS=300
RAW_RETENTION_DAYS=14
# Let accounts point at private addresses (a Prometheus on localhost or your LAN). Defaults to
# true in development and false in production, so a hosted API can't be aimed at internal hosts.
# ALLOW_PRIVATE_URLS=true

# ---- Generator ----
GENERATOR_URL=http://localhost:8100
# Any long random string; required once the generator is reachable from the internet.
GENERATOR_API_KEY=change-me

# ---- Agent (optional; without a key the rules engine and digests still work) ----
GOOGLE_API_KEY=
# flash-lite has the most generous free tier; gemini-2.5-flash / gemini-3.5-flash also work.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Azure deployment (deploy/azure/deploy.py, docs/deployment.md) ----
# Optional; the defaults are shown. AZURE_SUBSCRIPTION_ID picks a subscription if you have several.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=syncviewer-rg
AZURE_LOCATION=centralindia
# Static Web Apps only runs in a few regions; the site itself is served worldwide.
AZURE_WEB_LOCATION=eastasia
# Optional custom domain for the website (needs a DNS CNAME to the Static Web App first).
AZURE_WEB_DOMAIN=
# Secret the hourly collector trigger sends; the deploy creates one if this is empty.
COLLECTOR_TOKEN=
