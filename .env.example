# Copy to .env and fill in. Never commit .env.

# ---- Database (Supabase) ----
# Supabase dashboard > Connect. Paste the URLs exactly as shown ("postgresql://..." is fine; the
# driver is selected automatically). URL-encode special characters in the password (@ -> %40).
# Transaction pooler (port 6543): used by the API and collector.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Session pooler (port 5432) or direct connection: used by Alembic. Use the session pooler if the
# direct host is IPv6-only on your network.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Supabase Auth ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# Only if the project still uses the legacy HS256 secret; otherwise leave empty.
SUPABASE_JWT_SECRET=
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public by design; safe only because the data API is locked by migration.
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000
# Optional: how often the browser syncs while the tab is visible (ms).
# VITE_SYNC_INTERVAL_MS=30000

# ---- App ----
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Comma-separated; matching users become admin on first login.
ADMIN_EMAILS=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ---- Collector ----
COLLECT_INTERVAL_SECONDS=300
RAW_RETENTION_DAYS=14

# ---- Generator ----
GENERATOR_URL=http://generator:8100
GENERATOR_API_KEY=change-me

# ---- Agent (optional; without a key the rules engine and digests still work) ----
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Local development only (docker-compose.local.yml) ----
# Lets you call the API with self-minted HS256 test tokens when no Supabase project is attached.
# LOCAL_JWT_SECRET=
